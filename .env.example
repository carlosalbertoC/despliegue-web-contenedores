# Copie este archivo a .env y reemplace los valores.
# .env no se sube al repositorio ni se incluye en la imagen.

POSTGRES_USER=portal
POSTGRES_PASSWORD=cambiar_por_una_clave_larga
POSTGRES_DB=portal

# Mínimo 24 caracteres. Use un valor distinto en Blitz Cloud.
SESSION_SECRET=cambiar_por_una_cadena_aleatoria_de_24_o_mas

# false en local (HTTP). true en Blitz Cloud (HTTPS).
COOKIE_SECURE=false
